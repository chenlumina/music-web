<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>music-web</display-name>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <request-character-encoding>UTF-8</request-character-encoding>
  <response-character-encoding>UTF-8</response-character-encoding>

  <!-- 过滤器链顺序由 filter-mapping 的先后决定：统一编码在前，登录检查在后 -->
  <filter>
    <filter-name>encodingFilter</filter-name>
    <filter-class>com.chenlumina.musicweb.web.EncodingFilter</filter-class>
  </filter>
  <filter>
    <filter-name>authFilter</filter-name>
    <filter-class>com.chenlumina.musicweb.web.AuthFilter</filter-class>
  </filter>
  <filter>
    <filter-name>adminAuthFilter</filter-name>
    <filter-class>com.chenlumina.musicweb.web.AdminAuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>encodingFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>authFilter</filter-name>
    <url-pattern>/playlist</url-pattern>
    <url-pattern>/playlist/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>adminAuthFilter</filter-name>
    <url-pattern>/admin</url-pattern>
    <url-pattern>/admin/*</url-pattern>
  </filter-mapping>

  <!-- 统一异常兜底：404/500 与未捕获异常（含 DaoException）都进同一张错误页 -->
  <error-page>
    <error-code>404</error-code>
    <location>/WEB-INF/views/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>403</error-code>
    <location>/WEB-INF/views/error.jsp</location>
  </error-page>
  <error-page>
    <error-code>500</error-code>
    <location>/WEB-INF/views/error.jsp</location>
  </error-page>
  <error-page>
    <exception-type>java.lang.Throwable</exception-type>
    <location>/WEB-INF/views/error.jsp</location>
  </error-page>

</web-app>