<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

  <display-name>music-web</display-name>

  <welcome-file-list>
    <welcome-file>index.jsp</welcome-file>
  </welcome-file-list>

  <!-- 实验三演示过滤器链：编码在前、登录检查在后；只作用于 /lab/* 演示路径，不影响产品页面 -->
  <filter>
    <filter-name>labEncodingFilter</filter-name>
    <filter-class>com.chenlumina.musicweb.web.LabEncodingFilter</filter-class>
  </filter>
  <filter>
    <filter-name>labAuthFilter</filter-name>
    <filter-class>com.chenlumina.musicweb.web.LabAuthFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>labEncodingFilter</filter-name>
    <url-pattern>/lab/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>labAuthFilter</filter-name>
    <url-pattern>/lab/*</url-pattern>
  </filter-mapping>

</web-app>